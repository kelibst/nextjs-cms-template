{
  "name": "gaphto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker-compose -f infrastructure/docker-compose.yml up -d",
    "db:down": "docker-compose -f infrastructure/docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun drizzle/migrate.ts",
    "db:seed": "bun drizzle/seed.ts",
    "scrape": "cd scraper && bun src/index.ts",
    "scrape:xml": "cd scraper && bun src/parse-wxr.ts",
    "db:sync-data": "mkdir -p src/data public/images && cp scraper/output/*.json src/data/ && cp -r scraped-assets/. public/images/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@next/third-parties": "^16.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.96.2",
    "@tiptap/extension-character-count": "^3.22.1",
    "@tiptap/extension-image": "^3.22.1",
    "@tiptap/extension-link": "^3.22.1",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/react": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "minio": "^8.0.7",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "resend": "^6.10.0",
    "shadcn": "^4.1.2",
