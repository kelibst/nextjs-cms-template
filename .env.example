# Application
DATABASE_URL=postgresql://cms:cms_secret@127.0.0.1:5434/cms
NEXTAUTH_SECRET="change-me-run-openssl-rand-base64-32"
AUTH_SECRET="change-me-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="My CMS"

# PostgreSQL (Docker)
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_secret
POSTGRES_DB=cms
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_secret

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=cms-media
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/cms-media

# Email (Resend)
RESEND_API_KEY=your-resend-api-key-here
ADMIN_EMAIL=admin@example.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Environment
NODE_ENV=development
